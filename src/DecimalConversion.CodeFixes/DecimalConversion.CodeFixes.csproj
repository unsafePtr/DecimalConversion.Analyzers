<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>DecimalConversion</RootNamespace>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <PackageId>DecimalConversion.Analyzer</PackageId>
    <Version>1.3.0</Version>
    <Description>Roslyn analyzers and code fixes for two .NET 11 changes: double and float to decimal conversion goes through a helper that keeps the pre-.NET 11 rounding, and rounding a double to decimal digits rounds that helper's decimal.</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <!-- The plugin carries the package as the migration's feed, so dotnet pack refreshes that copy. -->
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\claude-plugin\skills\dotnet11-floating-point\packages</PackageOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.0.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.3.0" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DecimalConversion.Analyzers\DecimalConversion.Analyzers.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DecimalConversion.Tests" />
  </ItemGroup>
  <!-- The default helper as a plain file, outside every folder NuGet compiles into a consumer. -->
  <!-- A migration copies it into the chosen project before dotnet format runs. -->
  <!-- No fix then adds a file, so dotnet format rewrites no project file. -->
  <ItemGroup>
    <Compile Remove="Helper/**" />
    <None Include="Helper/FloatingPoint.cs" Pack="true" PackagePath="helper" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(OutputPath)\DecimalConversion.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(OutputPath)\DecimalConversion.CodeFixes.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>
</Project>
